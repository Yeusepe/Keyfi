NODE_ENV=development
PORT=8080
BASE_URL=https://keyfi.example.com
MONGODB_URI=mongodb://keyfi:REPLACE_WITH_HEX_PASSWORD@localhost:27017/keyfi?replicaSet=rs0&directConnection=true&authSource=keyfi
MONGODB_DATABASE=keyfi
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# OAuth credentials can be left blank for the basic Discord setup test.
# Gumroad sign-in requires the Discord secret plus its matching Gumroad app pair.
DISCORD_CLIENT_SECRET=
GUMROAD_BUYER_CLIENT_ID=
GUMROAD_BUYER_CLIENT_SECRET=
GUMROAD_CREATOR_CLIENT_ID=
GUMROAD_CREATOR_CLIENT_SECRET=
# Who operates Keyfi and how to reach them, e.g. "Jane Doe, privacy@example.com". Shown in the privacy notice.
PRIVACY_CONTACT=
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep the same key on every app instance and back it up separately from MongoDB.
ENCRYPTION_KEY=
# Docker Compose MongoDB bootstrap. Use different generated hex passwords.
MONGO_INITDB_ROOT_USERNAME=keyfi-admin
MONGO_INITDB_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
MONGO_REPLICA_HOST=mongodb:27017
