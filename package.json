{
  "name": "keyfi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "commands": "node --env-file-if-exists=.env --import tsx src/register.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/oauth2": "8.3.0",
    "discord-interactions": "4.4.0",
    "discord.js": "14.27.0",
    "fastify": "5.12.5",
    "mongodb": "7.6.0",
    "rate-limiter-flexible": "11.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "mongodb-memory-server": "11.3.0",
    "nock": "14.0.17",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
