FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS mongosh
RUN npm install --global --omit=dev mongosh@2.13.0

FROM mongo:8.0.34
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=mongosh /usr/local/bin/node /usr/local/bin/node
COPY --from=mongosh /usr/local/lib/node_modules/mongosh /opt/mongosh
# Keep the existing shell version while replacing its vulnerable embedded Node runtime.
RUN rm /usr/bin/mongosh && ln -s /opt/mongosh/bin/mongosh.js /usr/bin/mongosh && \
    mongosh --nodb --quiet --eval 'if (process.version !== "v24.22.1" || require("zlib").constants.BROTLI_DECODER_ERROR_FORMAT_BLOCK_SWITCH !== -17) throw new Error("Unpatched Mongo shell runtime")'
ENV NODE_OPTIONS=--use-openssl-ca SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
COPY deploy/mongo-entrypoint.sh /opt/keyfi/entrypoint.sh
COPY deploy/mongo-init.js /opt/keyfi/init.js
RUN chmod 755 /opt/keyfi/entrypoint.sh
ENTRYPOINT ["/opt/keyfi/entrypoint.sh"]
CMD ["mongod", "--replSet", "rs0", "--keyFile", "/data/db/keyfi.key", "--bind_ip_all", "--auth", "--logpath", "/dev/null", "--setParameter", "diagnosticDataCollectionEnabled=false"]
HEALTHCHECK --interval=10s --timeout=8s --start-period=30s CMD mongosh --quiet --file /opt/keyfi/init.js
